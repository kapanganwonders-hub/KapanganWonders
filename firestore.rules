rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'kapanganwonders@gmail.com';
    }

    // Contact page content
    match /content/contact {
      allow read: if true; // Anyone can read the contact page content
      allow write: if isAdmin(); // Only admin can update contact page content
    }
    
    // Allow admins to read/write all documents
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
